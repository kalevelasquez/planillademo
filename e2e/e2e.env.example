# Copiar a .env.e2e.local en la raíz del repo (gitignored) y completar con credenciales
# reales. Esas cuentas deben existir de antemano en el Supabase de develop (mismo
# proyecto que .env.development) — creá una por rol desde Gestión de Usuarios o el
# flujo de invitación antes de correr los tests. No hay forma de crearlas por API sin
# la service_role key, que no debe vivir en este repo.

E2E_BASE_URL=http://localhost:5173

E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=

E2E_PREPARADOR_EMAIL=
E2E_PREPARADOR_PASSWORD=

E2E_APROBADOR_EMAIL=
E2E_APROBADOR_PASSWORD=
